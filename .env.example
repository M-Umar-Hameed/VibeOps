DATABASE_URL=postgres://tickets:tickets@localhost:5433/tickets
PORT=8787

# Memory Extractor (OpenAI-compatible endpoint, Ollama, vLLM, LM Studio, llama-server, OpenRouter, Groq, or OpenAI)
# Falls back to Anthropic Haiku if ANTHROPIC_API_KEY is configured.
# Example for local LiquidAI LFM3 or DeepSeek-9B serving:
# MEMORY_EXTRACTOR_URL=http://127.0.0.1:8086/v1
# MEMORY_EXTRACTOR_MODEL=lfm3
# MEMORY_EXTRACTOR_API_KEY=

# Embedding Provider (local onnx nomic-embed-text-v1.5 768-dim, potion-base-8m 256-dim, or bge-m3 1024-dim)
# EMBED_PROVIDER=nomic
