!macro NSIS_HOOK_PREINSTALL
  nsExec::ExecToStack `powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Get-Process -Name node,VibeOps -ErrorAction SilentlyContinue | Where-Object { $$_.Path -like '$LOCALAPPDATA\VibeOps\*' } | Stop-Process -Force -ErrorAction SilentlyContinue"`
  Pop $0
  Pop $1
!macroend

!macro NSIS_HOOK_POSTINSTALL
  ; Register the hidden crash-heal watchdog (source: windows/keepalive-setup.ps1).
  nsExec::ExecToStack `powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand `
  Pop $0
  Pop $1
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  nsExec::ExecToStack `powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Get-Process -Name node,VibeOps -ErrorAction SilentlyContinue | Where-Object { $$_.Path -like '$LOCALAPPDATA\VibeOps\*' } | Stop-Process -Force -ErrorAction SilentlyContinue"`
  Pop $0
  Pop $1
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  ; Remove the watchdog (source: windows/keepalive-remove.ps1).
  nsExec::ExecToStack `powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand `
  Pop $0
  Pop $1
!macroend
